DATABASE_URL=postgresql+psycopg://flashsupport:flashsupport@postgres:5432/flashsupport
LLM_RUNTIME_URL=http://flashsupport-llm-runtime:8100
LLM_RUNTIME_TIMEOUT_SECONDS=180
EMBEDDING_MODEL_STORAGE_DIR=var/embedding-models
EMBEDDING_DEVICE=auto
DEFAULT_EMBEDDING_MODEL=
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=160
AUTH_PUBLIC_KEY_PATH=config/keys/auth/public.pem
AUTH_TOKEN_ISSUER=flashsupport-auth-service
USER_ACCESS_TOKEN_AUDIENCE=flashsupport-services
CLOCK_SKEW_SECONDS=10
